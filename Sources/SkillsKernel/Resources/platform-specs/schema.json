{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.dev/platform-specs/schema.json",
  "title": "Adapter Spec",
  "description": "描述某个 Agent Platform 加载语义的声明式数据文件。spec 本体用 YAML 撰写,本 schema 描述其解析后的结构。撰写指南见 SCHEMA.md。",
  "type": "object",
  "required": ["schema_version", "platform", "metadata", "resources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "spec 格式版本。当前只允许 1。",
      "type": "integer",
      "enum": [1]
    },
    "platform": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "平台唯一标识,小写短横线。",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": { "description": "平台展示名。", "type": "string" },
        "version_range": {
          "description": "spec 适用的平台版本范围,自由文本(如 \">=2.0\")。",
          "type": "string"
        },
        "docs_url": { "description": "平台官方文档入口。", "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["generated_by", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "generated_by": {
          "description": "spec 的生成方式。",
          "type": "string",
          "enum": ["ai", "human", "human+ai"]
        },
        "last_verified": {
          "description": "最后一次对照真实文件系统校验的日期(YYYY-MM-DD)。",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "verified_on": {
          "description": "校验时的环境描述(操作系统、平台版本等)。",
          "type": "string"
        },
        "notes": { "type": "string" }
      }
    },
    "resources": {
      "description": "平台会加载的 Agent Resource 列表,每条对应一个加载路径规则。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "shadowing": {
      "description": "优先级与遮蔽规则,引用 resources 中的 id。",
      "type": "array",
      "items": { "$ref": "#/$defs/shadowRule" }
    },
    "unmodeled": {
      "description": "unmodeled 扫描配置:在哪些根目录的邻域内检测 spec 未建模的可疑文件,以及已知可忽略的噪音。",
      "type": "object",
      "required": ["roots"],
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "scope"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "description": "扫描根目录。global scope 用 ~ 开头;project scope 用项目相对路径。",
                "type": "string"
              },
              "scope": { "type": "string", "enum": ["global", "project"] }
            }
          }
        },
        "ignore": {
          "description": "扫描时忽略的条目。写完整路径(~ 或项目相对),末段可用 * 通配。这些是已知的会话状态/缓存等非 Agent Resource。",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["id", "type", "scope", "path", "path_kind", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "规则唯一标识,小写短横线。",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "description": "资源类型:identity(身份/系统提示类)、guidance(指导性上下文)、skill(技能/命令)、runtime-config(运行时配置,浅覆盖)。",
          "type": "string",
          "enum": ["identity", "guidance", "skill", "runtime-config"]
        },
        "scope": {
          "description": "global=用户级(路径以 ~ 开头或绝对路径);project=项目级(相对项目根);directory=项目内任意子目录(path 为相对项目根的 glob)。",
          "type": "string",
          "enum": ["global", "project", "directory"]
        },
        "path": {
          "description": "加载路径。支持 ~ 展开;project/directory scope 相对项目根;path_kind 为 glob 时支持 * 与 **。",
          "type": "string"
        },
        "path_kind": {
          "description": "路径解释方式:file=单个文件;directory=整个目录;glob=通配模式。",
          "type": "string",
          "enum": ["file", "directory", "glob"]
        },
        "required": {
          "description": "平台是否要求该路径必须存在。绝大多数为 false(缺失只是 [missing],不是错误)。",
          "type": "boolean"
        },
        "description": { "description": "这条规则的人话说明。", "type": "string" },
        "source": {
          "description": "规则依据:官方文档 URL,或 \"本机观察\" 等说明。每条规则必填。",
          "type": "string"
        },
        "confidence": {
          "description": "对这条规则准确性的置信度。不确定宁标 low 也不省略。",
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "count": {
          "description": "仅 runtime-config 可用:存在性之外的浅计数方式。",
          "$ref": "#/$defs/countSpec"
        }
      }
    },
    "countSpec": {
      "type": "object",
      "required": ["method", "unit"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "description": "计数方法:json-keys=按 JSON pointer 取对象后数键;entries=数目录直接子项;files=按 file_pattern 数目录内文件。",
          "type": "string",
          "enum": ["json-keys", "entries", "files"]
        },
        "pointer": {
          "description": "method=json-keys 时的 JSON Pointer(如 /mcpServers)。",
          "type": "string",
          "pattern": "^(/[^/]*)*$"
        },
        "file_pattern": {
          "description": "method=files 时的相对 glob(如 */SKILL.md)。",
          "type": "string"
        },
        "unit": { "description": "计数单位,用于展示(如 servers、hooks、plugins)。", "type": "string" }
      }
    },
    "shadowRule": {
      "type": "object",
      "required": ["id", "strategy", "winner", "loser", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": { "type": "string" },
        "strategy": {
          "description": "override=同 key 时 winner 完全遮蔽 loser;merge=两者合并、冲突处 winner 优先。",
          "type": "string",
          "enum": ["override", "merge"]
        },
        "winner": { "description": "优先方的 resource id。", "type": "string" },
        "loser": { "description": "被遮蔽方的 resource id。", "type": "string" },
        "key": {
          "description": "以什么为同一性判定 key(如 skill-directory-name、settings-key)。",
          "type": "string"
        },
        "source": { "type": "string" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    }
  }
}
